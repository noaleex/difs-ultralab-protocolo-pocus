  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ap\xF3s avalia\xE7\xE3o dos protocolos cl\xEDnicos aplicados durante o
    seu plant\xE3o, a Dire\xE7\xE3o constatou falhas graves na condu\xE7\xE3o do
    tratamento e no uso adequado da ultrassonografia \xE0 beira-leito (POCUS), comprometendo
    a seguran\xE7a do paciente.\n\nDiante da gravidade da ocorr\xEAncia, o paciente
    foi imediatamente transferido para os cuidados de outro profissional de enfermagem.
    Por decis\xE3o administrativa, voc\xEA est\xE1 sendo afastado em definitivo de
    suas fun\xE7\xF5es nesta institui\xE7\xE3o."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 7ae4e632612f0c54b80a1122b781df6d, type: 2}
